# PyInstaller output (2.7 GB of build/release snapshots - never version these)
build*/
release*/
debug*/
dist/
*.manifest

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/

# Local scratch
*.log
*.bak
*.tmp
Thumbs.db
desktop.ini

# The icon SOURCES are third-party artwork and must never be published. The
# derived .ico files are tracked; the JPEGs they were built from are not.
assets/icon-sources/

# Design reference captures (UI screenshots) - tracked for reference only
docs/design/*.png

# Never publish anything that could carry a session, even by accident.
weread-live-settings.lua
session-cookies.json
credentials.json
.env
*.pfx
*.p12

# NOTE: these ARE tracked on purpose:
#   *.spec / installer\*.iss / installer\*.isl  - reproducible build + installer definition
#   assets\ (icons) / design\ (reference captures + NOTES.md)
#   *.py / *.lua / *.html / *.md                 - source and its tests
